# /etc/kitzy-push.env : propriétaire root, chmod 600. Ne jamais le mettre dans le dépôt.

# Générées une seule fois : node scripts/generate-keys.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact pour les services push (Google, Apple, Mozilla) en cas de problème.
VAPID_SUBJECT=mailto:notifications@kitzy.lu

# Les pages autorisées à abonner un appareil (séparées par des virgules).
ALLOWED_ORIGIN=https://kitzy.lu

# Derrière nginx : l'adresse du visiteur arrive dans X-Real-IP (limite de débit).
TRUST_PROXY=1
PORT=8787

# Facultatif
# SEND_HOUR=9
# MAX_SUBSCRIPTIONS=50000
