{
  "name": "kitzy",
  "private": true,
  "description": "Kitzy : constituer, suivre et faire tourner sa réserve d'urgence de 72 heures.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kitzy/web dev",
    "build": "pnpm --filter @kitzy/web build",
    "preview": "pnpm --filter @kitzy/web preview",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @kitzy/web e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
